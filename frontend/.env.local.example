# ─── Supabase ────────────────────────────────────────────────────────────────
# Project URL: https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose as NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=

# ─── Session ─────────────────────────────────────────────────────────────────
# Long random string. Generate with: openssl rand -hex 32
AUTH_SESSION_SECRET=

# ─── Blockchain / RPC ────────────────────────────────────────────────────────
# Morph Hoodi RPC. Defaults to https://rpc-hoodi.morph.network if unset.
MORPH_RPC_URL=https://rpc-hoodi.morph.network

# ─── Operator Keys (server-only, never expose as NEXT_PUBLIC_*) ──────────────
# Contract owner — calls setMerchantVerified on KYC approval
OWNER_PRIVATE_KEY=
# Signs wallet link operations (link-signature route)
LINK_OPERATOR_PRIVATE_KEY=
# Signs verification baseline updates (profile route)
VERIFICATION_OPERATOR_PRIVATE_KEY=

# ─── Email ───────────────────────────────────────────────────────────────────
# Option A: Gmail SMTP (both required to use Gmail)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Option B: Resend (fallback if Gmail vars are unset)
RESEND_API_KEY=
AUTH_EMAIL_FROM=RemitSafe <onboarding@resend.dev>
# If neither is set, OTPs are logged to the dev server console only.
