# Get a free RPC from Alchemy (morph-holesky) or QuickNode
MORPH_RPC_URL=https://your-rpc-url-here

# Supabase project settings
# Project URL looks like: https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key used by /api/signup. Never expose this as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. If unset, OTPs are logged in the dev server console and returned in dev responses.
RESEND_API_KEY=
AUTH_EMAIL_FROM=RemitSafe <onboarding@resend.dev>

# Used to sign login sessions. Generate a long random value for production.
AUTH_SESSION_SECRET=
