{
  "name": "remitsafe",
  "private": true,
  "version": "0.1.0",
  "description": "Blockchain-backed remittance pledge system for OFWs.",
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "contracts",
    "packages/shared"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace apps/web",
    "dev:mobile": "npm run start --workspace apps/mobile",
    "test:contracts": "npm run test --workspace contracts",
    "deploy:contracts": "npm run deploy --workspace contracts",
    "build:shared": "npm run build --workspace packages/shared"
  },
  "engines": {
    "node": ">=20"
  }
}
